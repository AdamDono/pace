# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/pace_db

# Flask Configuration
SECRET_KEY=your-secret-key-here
FLASK_DEBUG=true
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Admin Configuration
ADMIN_EMAIL=admin@paceacademy.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Email Configuration (Gmail Example)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here
MAIL_DEFAULT_SENDER=noreply@paceacademy.com

# Base URL for email links
BASE_URL=http://localhost:5000

# Instructions for Gmail:
# 1. Enable 2-Factor Authentication on your Google account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the generated app password as MAIL_PASSWORD (not your regular Gmail password)
# 4. MAIL_USERNAME should be your full Gmail address

# For other email providers:
# - Outlook: smtp.office365.com, port 587
# - Yahoo: smtp.mail.yahoo.com, port 587
# - SendGrid: smtp.sendgrid.net, port 587
# - Mailgun: smtp.mailgun.org, port 587
