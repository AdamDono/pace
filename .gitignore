# =======================
# Pace Academy .gitignore
# =======================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
.env/
#/
scratch/

# Environment variables — never commit secrets
.env

# Flask session & instance folders
flask_session/
instance/

# Database files (SQLite & PostgreSQL dumps)
*.db
*.sqlite3
*.tar.gz
*.dir
2026-*Z/

# Logs and temp files
*.log
*.tmp
server.log
server_debug.log

# OS generated files
.DS_Store
Thumbs.db

# IDEs and editor settings
.vscode/
.idea/
*.swp
*.sublime-project
*.sublime-workspace

# Migrations (uncomment if you recreate them regularly)
# migrations/

# Coverage and testing
.coverage
htmlcov/
.pytest_cache/

# Ignore vscode AI rules
.github/instructions/codacy.instructions.md
docs/investors/injini_ai_venture_builder_application.md
docs/investors/launch_africa_application.md
docs/marketing/facebook_intro_posts_and_brand_launch.md
docs/marketing/facebook_marketing_and_ads_strategy.md
docs/investors/master_venture_application_answers.md
