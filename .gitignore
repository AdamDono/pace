# =======================
# Pace Academy .gitignore
# =======================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
.env/
#/
scratch/

# Environment variables — never commit secrets
.env

# Flask session & instance folders
flask_session/
instance/

# Database files (SQLite & PostgreSQL dumps)
*.db
*.sqlite3
*.tar.gz
*.dir

# Logs and temp files
*.log
*.tmp
server.log
server_debug.log

# OS generated files
.DS_Store
Thumbs.db

# IDEs and editor settings
.vscode/
.idea/
*.swp
*.sublime-project
*.sublime-workspace

# Migrations (uncomment if you recreate them regularly)
# migrations/

# Coverage and testing
.coverage
htmlcov/
.pytest_cache/

# Ignore vscode AI rules
.github/instructions/codacy.instructions.md
