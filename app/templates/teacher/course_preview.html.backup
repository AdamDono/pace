<!-- templates/teacher/course_preview.html -->
{% extends "base.html" %}

{% block content %}
<div class="min-h-screen bg-gray-50">
    <!-- Header with back button -->
    <div class="bg-white shadow-sm border-b">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center">
                    <a href="{{ url_for('teacher.manage_modules', course_id=course.id) }}"
                       class="flex items-center text-gray-600 hover:text-gray-900">
                        <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                        </svg>
                        Back to Course Management
                    </a>
                </div>
                <div class="flex items-center space-x-4">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
                        Preview Mode
                    </span>
                    <span class="text-sm text-gray-500">How students will see your course</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Course Header -->
    <div class="bg-white shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <div class="lg:flex lg:items-start lg:justify-between">
                <div class="min-w-0 flex-1">
                    <!-- Course Title -->
                    <h1 class="text-3xl font-bold text-gray-900 mb-2">{{ course.title }}</h1>

                    <!-- Course Meta -->
                    <div class="flex flex-wrap items-center text-sm text-gray-600 mb-4 space-x-4">
                        <span class="flex items-center">
                            <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4"></path>
                            </svg>
                            {{ course.difficulty_level.title() if course.difficulty_level else 'Intermediate' }}
                        </span>
                        {% if course.estimated_duration %}
                        <span class="flex items-center">
                            <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            {{ course.estimated_duration }} hours
                        </span>
                        {% endif %}
                        {% if course.category %}
                        <span class="flex items-center">
                            <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                            </svg>
                            {{ course.category.title() }}
                        </span>
                        {% endif %}
                    </div>

                    <!-- Course Description -->
                    <div class="prose prose-gray max-w-none mb-6">
                        <p class="text-gray-700 text-lg leading-relaxed">{{ course.description }}</p>
                    </div>

                    <!-- Learning Objectives -->
                    {% if course.learning_objectives %}
                    <div class="mb-6">
                        <h3 class="text-lg font-semibold text-gray-900 mb-3">What you'll learn</h3>
                        <div class="bg-blue-50 rounded-lg p-4">
                            <ul class="space-y-2">
                                {% for objective in course.learning_objectives.split('\n') %}
                                    {% if objective.strip() and objective.strip() != '•' %}
                                    <li class="flex items-start">
                                        <svg class="h-5 w-5 text-blue-600 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                                        </svg>
                                        <span class="text-gray-700">{{ objective | replace('•', '') | trim }}</span>
                                    </li>
                                    {% endif %}
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                    {% endif %}

                    <!-- Prerequisites -->
                    {% if course.prerequisites %}
                    <div class="mb-6">
                        <h3 class="text-lg font-semibold text-gray-900 mb-3">Prerequisites</h3>
                        <div class="bg-amber-50 rounded-lg p-4">
                            <ul class="space-y-2">
                                {% for prereq in course.prerequisites.split('\n') %}
                                    {% if prereq.strip() and prereq.strip() != '•' %}
                                    <li class="flex items-start">
                                        <svg class="h-5 w-5 text-amber-600 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
                                        </svg>
                                        <span class="text-gray-700">{{ prereq | replace('•', '') | trim }}</span>
                                    </li>
                                    {% endif %}
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                    {% endif %}
                </div>

                <!-- Course Sidebar -->
                <div class="mt-8 lg:mt-0 lg:ml-8 lg:flex-shrink-0">
                    <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
                        <!-- Course Banner -->
                        {% if course.banner_image %}
                        <div class="mb-4">
                            <img src="{{ url_for('static', filename='uploads/' + course.banner_image) }}"
                                 alt="Course banner" class="w-full h-32 object-cover rounded-lg">
                        </div>
                        {% endif %}

                        <!-- Enroll Button (Disabled in preview) -->
                        <button disabled
                                class="w-full bg-gray-300 text-gray-500 font-semibold py-3 px-4 rounded-lg mb-4 cursor-not-allowed">
                            Enroll Now (Preview Mode)
                        </button>

                        <!-- Course Stats -->
                        <div class="space-y-3 text-sm">
                            <div class="flex justify-between">
                                <span class="text-gray-600">Duration:</span>
                                <span class="font-medium">{{ course.estimated_duration or 'TBD' }} hours</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-600">Sections:</span>
                                <span class="font-medium">{{ sections|length }}</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-600">Language:</span>
                                <span class="font-medium">{{ course.language.title() if course.language else 'English' }}</span>
                            </div>
                        </div>

                        <!-- Tags -->
                        {% if course.tags %}
                        <div class="mt-4 pt-4 border-t border-gray-200">
                            <div class="flex flex-wrap gap-2">
                                {% for tag in course.tags.split(',') %}
                                    {% if tag.strip() %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                        {{ tag.strip() }}
                                    </span>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Course Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Course Content Sections -->
        {% if modules %}
            <!-- Modular Structure -->
            {% for module in modules %}
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 mb-6">
                <div class="p-6 border-b border-gray-200">
                    <h2 class="text-xl font-semibold text-gray-900">{{ module.title }}</h2>
                    {% if module.description %}
                    <p class="text-gray-600 mt-1">{{ module.description }}</p>
                    {% endif %}
                </div>

                <div class="divide-y divide-gray-200">
                    {% for section in module.sections %}
                    <div class="p-6 hover:bg-gray-50 transition-colors">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-3">
                                <div class="flex-shrink-0">
                                    {% if section.section_type == 'video' %}
                                        <svg class="h-8 w-8 text-red-600" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M8 5v14l11-7z"/>
                                        </svg>
                                    {% elif section.section_type == 'quiz' %}
                                        <svg class="h-8 w-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                        </svg>
                                    {% elif section.section_type == 'assignment' %}
                                        <svg class="h-8 w-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                        </svg>
                                    {% else %}
                                        <svg class="h-8 w-8 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                        </svg>
                                    {% endif %}
                                </div>
                                <div>
                                    <h3 class="text-lg font-medium text-gray-900">{{ section.title }}</h3>
                                    {% if section.content %}
                                    <p class="text-gray-600 text-sm mt-1 line-clamp-2">{{ section.content | striptags }}</p>
                                    {% endif %}
                                    <div class="flex items-center space-x-4 mt-2 text-sm text-gray-500">
                                        <span>{{ section.section_type.title() }}</span>
                                        {% if section.duration %}
                                        <span>{{ section.duration }} min</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endfor %}
        {% elif sections %}
            <!-- Section-only structure -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200">
                <div class="p-6 border-b border-gray-200">
                    <h2 class="text-xl font-semibold text-gray-900">Course Content</h2>
                </div>

                <div class="divide-y divide-gray-200">
                    {% for section in sections %}
                    <div class="p-6 hover:bg-gray-50 transition-colors">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-3">
                                <div class="flex-shrink-0">
                                    {% if section.section_type == 'video' %}
                                        <svg class="h-8 w-8 text-red-600" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M8 5v14l11-7z"/>
                                        </svg>
                                    {% elif section.section_type == 'quiz' %}
                                        <svg class="h-8 w-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                        </svg>
                                    {% elif section.section_type == 'assignment' %}
                                        <svg class="h-8 w-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                        </svg>
                                    {% else %}
                                        <svg class="h-8 w-8 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                        </svg>
                                    {% endif %}
                                </div>
                                <div>
                                    <h3 class="text-lg font-medium text-gray-900">{{ section.title }}</h3>
                                    {% if section.content %}
                                    <p class="text-gray-600 text-sm mt-1 line-clamp-2">{{ section.content | striptags }}</p>
                                    {% endif %}
                                    <div class="flex items-center space-x-4 mt-2 text-sm text-gray-500">
                                        <span>{{ section.section_type.title() }}</span>
                                        {% if section.duration %}
                                        <span>{{ section.duration }} min</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        {% else %}
            <!-- No content yet -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-12 text-center">
                <svg class="mx-auto h-24 w-24 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
                <h3 class="text-xl font-medium text-gray-900 mb-2">No course content yet</h3>
                <p class="text-gray-600 mb-6">Add sections and modules to build your course curriculum.</p>
                <a href="{{ url_for('teacher.manage_modules', course_id=course.id) }}"
                   class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700">
                    Add Course Content
                </a>
            </div>
        {% endif %}
    </div>
</div>

<style>
.line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-clamp: 2; /* Standard property for compatibility */
}
</style>

{% endblock %}
